# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
# Playwright artifacts (also ignored in apps/web; this catches runs from the repo root)
test-results/
playwright-report/
# PROMPT-14 simulation failure artifacts (uploaded by CI, replayed via sim:replay)
sim-failures/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
scripts/.seed-demo-state.json
packages/engine/sim-report.json
.playwright-mcp/
# Superpowers visual-companion brainstorm sessions
.superpowers/

# Session screenshots keep landing in the repo root — never track them.
/*.png

# Turborepo
.turbo

# Subagent scratch memory. Agents write these under whatever package they are
# working in, so they appear as untracked dirs anywhere in the tree — and a
# single `git add -A` would commit twelve of them. Agent DEFINITIONS
# (.claude/agents/*.md) stay tracked; only the per-run memory is ignored.
**/.claude/agent-memory/
