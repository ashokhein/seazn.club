{"nodes": [{"id": "design_v2_prompts_prompt_11_api_v1_platform_api_v1", "label": "Platform API /api/v1", "file_type": "document", "source_file": "design/v2/prompts/PROMPT-11-api-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v2_prompts_prompt_11_api_v1_service_layer_usecases", "label": "Service layer use-cases (one module per aggregate)", "file_type": "rationale", "source_file": "design/v2/prompts/PROMPT-11-api-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Route handlers and Server Components both call the use-case layer so no logic lives in routes; auth then entitlement gates then engine-db adapter, in that order."}, {"id": "design_v2_prompts_prompt_11_api_v1_scoring_endpoint_contract", "label": "Scoring endpoint concurrency contract", "file_type": "rationale", "source_file": "design/v2/prompts/PROMPT-11-api-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "expected_seq optimistic concurrency plus a 24h Redis idempotency key so parallel scorers converge with no lost events; 201/409/422 contract fixed by doc 08 \u00a74."}, {"id": "design_v2_prompts_prompt_11_api_v1_api_keys", "label": "API keys and bearer auth middleware", "file_type": "concept", "source_file": "design/v2/prompts/PROMPT-11-api-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sk_live_ secrets are 32B random, sha256-stored and shown once; key resolves to org + scopes, gated by entitlement api.access with a per-key rate limit."}, {"id": "design_v2_prompts_prompt_11_api_v1_public_views_read_path", "label": "Public endpoints read only public_*_v views", "file_type": "rationale", "source_file": "design/v2/prompts/PROMPT-11-api-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cache-Control plus Redis cache-aside with watermark invalidation keeps public reads off auth'd query paths entirely."}, {"id": "design_v2_prompts_prompt_11_api_v1_openapi_spec_generation", "label": "OpenAPI generated from shared Zod schemas", "file_type": "concept", "source_file": "design/v2/prompts/PROMPT-11-api-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generating from the Zod schemas that already validate routes means a CI drift gate can fail the build when spec and implementation diverge."}], "edges": [{"source": "design_v2_prompts_prompt_11_api_v1_platform_api_v1", "target": "design_v2_prompts_prompt_11_api_v1_service_layer_usecases", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v2/prompts/PROMPT-11-api-v1.md", "source_location": null, "weight": 1.0}, {"source": "design_v2_prompts_prompt_11_api_v1_platform_api_v1", "target": "design_v2_prompts_prompt_11_api_v1_scoring_endpoint_contract", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v2/prompts/PROMPT-11-api-v1.md", "source_location": null, "weight": 1.0}, {"source": "design_v2_prompts_prompt_11_api_v1_platform_api_v1", "target": "design_v2_prompts_prompt_11_api_v1_api_keys", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v2/prompts/PROMPT-11-api-v1.md", "source_location": null, "weight": 1.0}, {"source": "design_v2_prompts_prompt_11_api_v1_platform_api_v1", "target": "design_v2_prompts_prompt_11_api_v1_public_views_read_path", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v2/prompts/PROMPT-11-api-v1.md", "source_location": null, "weight": 1.0}, {"source": "design_v2_prompts_prompt_11_api_v1_platform_api_v1", "target": "design_v2_prompts_prompt_11_api_v1_openapi_spec