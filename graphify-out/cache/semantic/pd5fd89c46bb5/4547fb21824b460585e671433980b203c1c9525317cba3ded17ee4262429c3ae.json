{"nodes": [{"id": "design_v6_00_sport_expansion_spec_nested_kernel", "label": "Nested scoring kernel (point\u2192game\u2192set)", "file_type": "rationale", "source_file": "design/v6/00-sport-expansion-spec.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The set-based kernel's flat state and setTo/winBy/cap predicate have no game layer; bolting one on would fork every consumer assumption (SetbasedPad, summaries), so a separate kernel keeps both simple \u2014 squash/pickleball still fit set-based, padel fits nested."}, {"id": "design_v6_00_sport_expansion_spec_period_kernel", "label": "Period kernel (n periods + overtime policy)", "file_type": "rationale", "source_file": "design/v6/00-sport-expansion-spec.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Football is the only timed-period module and hardcodes halves: literal(2) with cards buried in its private event union; generalising the phase machine unlocks 3-period ice hockey and 4-quarter field hockey without a per-sport machine."}, {"id": "design_v6_00_sport_expansion_spec_shootout_primitive", "label": "Parameterized shootout primitive", "file_type": "rationale", "source_file": "design/v6/00-sport-expansion-spec.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Football pens, IIHF GWS and FIH shoot-out are one shape \u2014 best-of-5 alternating with early-out then sudden death \u2014 so the football-private implementation is extracted and parameterized instead of copied twice."}, {"id": "design_v6_00_sport_expansion_spec_suspension_track", "label": "Timed suspension track (strength, PIM, cards)", "file_type": "rationale", "source_file": "design/v6/00-sport-expansion-spec.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Suspension end is an explicit event because the engine has no clock: pads show a countdown hint from recorded_at wall time but the fold only trusts events, which keeps the determinism gate intact."}, {"id": "design_v6_00_sport_expansion_spec_no_clock_decision", "label": "No real clock in the engine", "file_type": "rationale", "source_file": "design/v6/00-sport-expansion-spec.md", "source_location": "\u00a76.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Periods and suspensions advance by events only; elapsed displays are UI sugar derived from recorded_at, so no Date.now() ever enters a module."}, {"id": "design_v6_00_sport_expansion_spec_football_golden_replay", "label": "Football refactor gated on golden-replay equivalence", "file_type": "rationale", "source_file": "design/v6/00-sport-expansion-spec.md", "source_location": "\u00a76.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Existing ledgers must replay byte-identically; module_version stays 1.0.0 if identical, otherwise bump minor and keep the legacy fold path \u2014 the replay result decides, not judgment."}, {"id": "design_v6_00_sport_expansion_spec_penalty_law_fidelity", "label": "Modules record and derive, never adjudicate penalty law", "file_type": "rationale", "source_file": "design/v6/00-sport-expansion-spec.md", "source_location": "\u00a76.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Strength, PIM and escalation hints are derived, but coincidental/delayed-penalty law is the scorer's call with core.note for context \u2014 the full NHL/IIHF situation handbook is out of scope."}, {"id": "design_v6_00_sport_expansion_spec_tennis_module", "label": "tennis module", "file_type": "code", "source_file": "design/v6/00-sport-expansion-spec.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v6_00_sport_expansion_spec_icehockey_module", "label": "icehockey module", "file_type": "code", "source_file": "design/v6/00-sport-expansion-spec.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v6_00_sport_expansion_spec_hockey_module", "label": "hockey (field) module", "file_type": "code", "source_file": "design/v6/00-sport-expansion-spec.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v6_00_sport_expansion_spec_tennis_pad", "label": "TennisPad (NESTED dispatch set)", "file_type": "rationale", "source_file": "design/v6/00-sport-expansion-spec.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Registers in a new NESTED set in both dispatch points and must not be added to SETBASED, mirroring the kernel separation at the UI layer."}, {"id": "design_v6_00_sport_expansion_spec_period_pad", "label": "PeriodPad (shared by both hockeys)", "file_type": "rationale", "source_file": "design/v6/00-sport-expansion-spec.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One pad covers goals with scorer/assists/type, penalty class pickers driven by SuspensionCfg, period advance, OT/shootout attempt recording and an always-visible strength chip \u2014 and is the future home for football."}, {"id": "design_v6_00_sport_expansion_spec_key_naming", "label": "Key naming: hockey = field, icehockey = ice", "file_type": "rationale", "source_file": "design/v6/00-sport-expansion-spec.md", "source_location": "\u00a76.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Matches existing match-length.ts and venue.ts placeholders; renaming later would require a catalog migration."}, {"id": "design_v6_00_sport_expansion_spec_no_migration", "label": "No migration \u2014 catalog rows via sync-sports", "file_type": "rationale", "source_file": "design/v6/00-sport-expansion-spec.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sports are DB catalog rows, not schema, so adding a sport means re-running scripts/sync-sports.ts against every environment DB \u2014 the division builder reads the DB catalog, not the engine registry."}, {"id": "design_v6_00_sport_expansion_spec_game_ratio_comparator", "label": "game_ratio tiebreak comparator", "file_type": "code", "source_file": "design/v6/00-sport-expansion-spec.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "design_v6_00_sport_expansion_spec_nested_kernel", "target": "design_v6_01_rules_digest_itf_rules_of_tennis", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v6/00-sport-expansion-spec.md", "source_location": "\u00a72", "weight": 1.0}, {"source": "design_v6_00_sport_expansion_spec_period_kernel", "target": "design_v6_01_rules_digest_iihf_rulebook", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v6/00-sport-expansion-spec.md", "source_location": "\u00a73", "weight": 1.0}, {"source": "design_v6_00_sport_expansion_spec_period_kernel", "target": "design_v6_01_rules_digest_fih_rules", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v6/00-sport-expansion-spec.md", "source_location": "\u00a73", "weight": 1.0}, {"source": "design_v6_00_sport_expansion_spec_period_kernel", "target": "design_v6_00_sport_expansion_spec_shootout_primitive", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v6/00-sport-expansion-spec.md", "source_location": "\u00a73", "weight": 1.0}, {"source": "design_v6_00_sport_expansion_spe