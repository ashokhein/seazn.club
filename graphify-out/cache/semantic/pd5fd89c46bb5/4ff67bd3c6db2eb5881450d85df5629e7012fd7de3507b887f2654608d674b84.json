{"nodes": [{"id": "design_v2_sports_volleyball_volleyball_module", "label": "Volleyball module (setbased preset)", "file_type": "document", "source_file": "design/v2/sports/volleyball.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v2_sports_volleyball_uncapped_set_predicate", "label": "Uncapped win-by-two set predicate", "file_type": "rationale", "source_file": "design/v2/sports/volleyball.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "cap: null means no golden point, so 24-24 plays on indefinitely \u2014 the deliberate contrast with badminton's hard cap at 30."}, {"id": "design_v2_sports_volleyball_points_map", "label": "pointsMap: match points depend on the set score", "file_type": "rationale", "source_file": "design/v2/sports/volleyball.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FIVB awards 3 points for 3-0/3-1 but splits 2/1 for 3-2, so competition points are a function of the set score rather than a flat win value; school leagues override via cfg."}, {"id": "design_v2_sports_volleyball_ratio_cascade", "label": "set_ratio / point_ratio cross-multiplied cascade", "file_type": "concept", "source_file": "design/v2/sports/volleyball.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ratios are integer pairs compared by cross-multiplication; sets_lost = 0 is treated as +infinity so an undefeated team ranks first instead of dividing by zero."}, {"id": "design_v2_sports_volleyball_coarsen_hook", "label": "coarsen(rallyEvents) conformance hook", "file_type": "rationale", "source_file": "design/v2/sports/volleyball.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mandatory hook proving that folding fine rally events produces exactly the coarse set summaries, which is what lets the two fidelity tiers share all downstream math."}, {"id": "design_v2_sports_volleyball_libero_lineup", "label": "Libero and rotation as unenforced metadata", "file_type": "rationale", "source_file": "design/v2/sports/volleyball.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Libero replacement rules surface as warnings not blocks and court rotation is Pro-stat metadata \u2014 referees enforce rotation, not the app; courtside reality wins over strictness."}, {"id": "design_v2_sports_volleyball_golden_set", "label": "Golden set as a child fixture", "file_type": "concept", "source_file": "design/v2/sports/volleyball.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A one-set decider is just {bestOf: 1, setTo: 15} on a child fixture \u2014 the kernel handles it with no new code."}], "edges": [{"source": "design_v2_sports_volleyball_volleyball_module", "target": "design_v2_sports_volleyball_uncapped_set_predicate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v2/sports/volleyball.md", "source_location": null, "weight": 1.0}, {"source": "design_v2_sports_volleyball_volleyball_module", "target": "design_v2_sports_volleyball_points_map", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v2/sports/volleyball.md", "source_location": null, "weight": 1.0}, {"source": "design_v2_sports_volleyball_ratio_cascade", "target": "design_v2_sports_volleyball_points_map", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v2/sports/volleyball.md", "source_location": null, "weight": 1.0}, {"source": "design_v2_sports_volleyball_volleyball_module", "target": "design_v2_sports_volleyball_coarsen_hook", "relatio