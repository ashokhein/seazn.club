{"nodes": [{"id": "design_v4_03_two_phase_officials_and_intake_two_phase_architect", "label": "Two-phase matchday architect (Phase A schedule, Phase B officials)", "file_type": "rationale", "source_file": "design/v4/03-two-phase-officials-and-intake.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both phases share solver-drafts \u2192 LLM-plans \u2192 engine-referees; two separate propose-only endpoints with the client carrying both proposals avoids a joint time+official optimisation and any distributed transaction."}, {"id": "design_v4_03_two_phase_officials_and_intake_officials_ai_plan_endpoint", "label": "POST /api/v1/divisions/{id}/officials/ai-plan", "file_type": "code", "source_file": "design/v4/03-two-phase-officials-and-intake.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v4_03_two_phase_officials_and_intake_build_officials_pack", "label": "buildOfficialsPack", "file_type": "code", "source_file": "design/v4/03-two-phase-officials-and-intake.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v4_03_two_phase_officials_and_intake_assign_officials", "label": "assignOfficials engine solver", "file_type": "rationale", "source_file": "design/v4/03-two-phase-officials-and-intake.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Takes injected epoch-ms fixture times so a dry-run schedule slots straight in with zero engine change; it may violate blackouts/busy-elsewhere, which is exactly what the LLM+referee pass exists to fix."}, {"id": "design_v4_03_two_phase_officials_and_intake_ai_officials_plan", "label": "AiOfficialsPlan strict schema", "file_type": "code", "source_file": "design/v4/03-two-phase-officials-and-intake.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v4_03_two_phase_officials_and_intake_server_referee_supplement", "label": "Web-side referee supplement (kind: ineligible)", "file_type": "rationale", "source_file": "design/v4/03-two-phase-officials-and-intake.md", "source_location": "\u00a77.8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The engine validates a locked set only for overlap/self-ref/pool-leak, so wrong-role, maxPerDay, official-blackout and busy-elsewhere breaches are checked in the use-case rather than adding new engine conflict kinds."}, {"id": "design_v4_03_two_phase_officials_and_intake_officials_coverage", "label": "officials_coverage preview in Phase A", "file_type": "rationale", "source_file": "design/v4/03-two-phase-officials-and-intake.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A server-side assignOfficials dry pass costs no LLM tokens either way; officials availability stays soft context in Phase A so the engine referee remains the only authority on legality."}, {"id": "design_v4_03_two_phase_officials_and_intake_preflight_card", "label": "Pre-flight card (guided intake)", "file_type": "rationale", "source_file": "design/v4/03-two-phase-officials-and-intake.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shows live rows of exactly what the AI will see with \u2713/\u26a0 deep links; data gaps are links, not gates \u2014 warnings never block the run."}, {"id": "design_v4_03_two_phase_officials_and_intake_wish_chips", "label": "Wish chips compiling into the instruction", "file_type": "rationale", "source_file": "design/v4/03-two-phase-officials-and-intake.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chips are copy plus pickers that fill an editable textarea \u2014 no new API \u2014 aimed at the infrequent user who does not know what to type."}, {"id": "design_v4_03_two_phase_officials_and_intake_repair_nudges", "label": "Client-derived repair nudges", "file_type": "rationale", "source_file": "design/v4/03-two-phase-officials-and-intake.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Disruption signals (fixture inside a new blackout, court no longer in courts[], fixture outside every window, postponed with a slot) are derived from data the board already has \u2014 no server disruption detection and no polling."}, {"id": "design_v4_03_two_phase_officials_and_intake_ledger_audit_trail", "label": "Ledger-payload audit trail", "file_type": "rationale", "source_file": "design/v4/03-two-phase-officials-and-intake.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "schedule_applied / officials_assigned payloads gain {source, instruction, summary, model, repair_rounds}; payload is jsonb so no migration, and last-run recall reads the existing ledger query family instead of a new table."}, {"id": "design_v4_03_two_phase_officials_and_intake_admin_override", "label": "Per-org entitlement override for AI gates", "file_type": "rationale", "source_file": "design/v4/03-two-phase-officials-and-intake.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "org_entitlement_overrides resolves before the plan matrix with expiry and busts the entitlement cache; the PostHog kill-switch stays the separate global off-switch."}, {"id": "design_v4_03_two_phase_officials_and_intake_pro_plus_drift_fix", "label": "Drift fix: scheduling.ai moved to Pro Plus (V290)", "file_type": "rationale", "source_file": "design/v4/03-two-phase-officials-and-intake.md", "source_location": "\u00a70",