{"nodes": [{"id": "docs_superpowers_specs_2026_07_22_billing_invoice_attribution_and_decline_grace_design_billing_events_subscription_id", "label": "V317 billing_events.subscription_id (durable group stamp)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-22-billing-invoice-attribution-and-decline-grace-design.md", "source_location": "Part A", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FK-less on purpose, matching V259 which dropped the org FK \u2014 the ledger is an append-only audit trail that must survive deletion of the thing it references. Null means 'unresolved' and falls back to today's org attribution."}, {"id": "docs_superpowers_specs_2026_07_22_billing_invoice_attribution_and_decline_grace_design_resolve_event_group", "label": "resolveEventGroup dispatcher", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-22-billing-invoice-attribution-and-decline-grace-design.md", "source_location": "Part A", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Best-effort and reuses the resolvers already in the file \u2014 no new resolution logic; a throw returns null and just falls back to org attribution. Runs BEFORE processStripeEvent because for invoice events the group row and its stripe_subscription_id already exist; any future event type that creates its group within the same event would need a post-process UPDATE instead."}, {"id": "docs_superpowers_specs_2026_07_22_billing_invoice_attribution_and_decline_grace_design_invoice_metadata_gap", "label": "Stripe never copies subscription metadata onto invoices", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-22-billing-invoice-attribution-and-decline-grace-design.md", "source_location": "Root cause", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "checkout.session.completed and customer.subscription.* carry metadata.subscription_id, but invoice events do not, so the admin page's live-metadata read falls back to a single org name \u2014 invisible on exactly the recurring group invoice the report is about."}, {"id": "docs_superpowers_specs_2026_07_22_billing_invoice_attribution_and_decline_grace_design_incomplete_past_due_grace", "label": "Part B2 \u2014 incomplete\u2192past_due opens the 14-day grace", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-22-billing-invoice-attribution-and-decline-grace-design.md", "source_location": "Part B2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A checkout where 3DS is never completed leaves the subscription incomplete, which maps to past_due and starts dunning \u2014 so a subscription that never took a successful payment can grant 14 days of Pro. The intended backstop is incomplete_expired\u2192canceled, but whether Stripe reliably fires an ingested event needs live test mode to confirm before choosing between the two candidate fixes."}, {"id": "docs_superpowers_specs_2026_07_22_billing_invoice_attribution_and_decline_grace_design_decline_at_checkout_gap", "label": "Part B1 \u2014 decline card at embedded checkout unexercised", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-22-billing-invoice-attribution-and-decline-grace-design.md", "source_location": "Part B1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Blocked on an sk_test key; captured with analysis so a keyed session starts cold. Part A ships independently and now \u2014 do not block A on B."}], "edges": [{"source": "docs_superpowers_specs_2026_07_22_billing_invoice_attribution_and_decline_grace_design_billing_events_subscription_id", "target": "docs_superpowers_specs_2026_07_22_billing_invoice_attribution_and_decline_grace_design_invoice_metadata_gap", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-22-billing-invoice-attribution-and-decline-grace-design.md", "source_location": "Part A", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_22_billing_invoice_attribution_and_decline_grace_design_resolve_event_group", "target": "docs_superpowers_specs_2026_07_22_billing_invoice_attribution_and_decline_grace_design_billing_events_subscription_id", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-22-billing-invoice-attribution-and-decline-grace-design.md", "source_location": "Part A", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_22_billing_invoice_attribution_and_decline_grace_design_resolve_event_group", "target": "docs_superpowers_specs_2026_07_21_billing_groups_design_billing_group", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-22-billing-invoice-attribution-and-decline-grace-design.md", "source_location": "Part A root cause", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_22_billing_invoice_attribution_and_decline_grace_design_incomplete_past_due_grace", "target": "docs_superpowers_specs_2026_07_21_billing_failure_paths_backlog_status_map", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-22-billing-invoice-attribution-and-decline-grace-design.md", "source_location": "Part B2", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_22_billing_invoice_attribution_and_decline_grace_design_decline_at_checkout_gap", "target": "docs_superpowers_specs_2026_07_21_billing_failure_paths_backlog_declined_card_ui_gap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-22-billing-invoice-attribution-and-decline-grace-design.md", "source_location": "Part B1", "weight": 1.0}, {"source": "docs_superp