{"nodes": [{"id": "design_v3_01_routing_and_navigation_routing_and_navigation", "label": "v3 Routing & Navigation", "file_type": "document", "source_file": "design/v3/01-routing-and-navigation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v3_01_routing_and_navigation_org_comp_div_url_scheme", "label": "/o/[orgSlug]/c/[compSlug]/d/[divSlug] URL scheme", "file_type": "rationale", "source_file": "design/v3/01-routing-and-navigation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The console mirrors the public hierarchy under an /o prefix to avoid colliding with marketing routes; /o /c /d segment markers keep parsing unambiguous while keeping URLs short. Fixtures get a per-division ordinal so a match is human-quotable ('look at match 14')."}, {"id": "design_v3_01_routing_and_navigation_url_beats_cookie", "label": "URL beats cookie (requireOrgPage)", "file_type": "rationale", "source_file": "design/v3/01-routing-and-navigation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Active org living in the seazn_org cookie means two tabs on two orgs silently corrupt each other; authorising membership from the path (and only setting the cookie as a side effect for API routes and legacy redirects) makes multi-org tabs safe."}, {"id": "design_v3_01_routing_and_navigation_breadcrumbs", "label": "Route-param-derived <Breadcrumbs>", "file_type": "concept", "source_file": "design/v3/01-routing-and-navigation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Derived entirely from route params in the console layout so no page wires its own trail; the org segment doubles as the org switcher, replacing the separate header control."}, {"id": "design_v3_01_routing_and_navigation_back_button", "label": "Universal back button to structural parent", "file_type": "rationale", "source_file": "design/v3/01-routing-and-navigation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Targets the structural parent from the breadcrumb chain rather than history.back(), so it is predictable, works on deep links and never exits the app; 44x44px touch target with an aria-label naming the parent."}, {"id": "design_v3_01_routing_and_navigation_route_builder", "label": "lib/routes.ts route builder + lint ban on string hrefs", "file_type": "rationale", "source_file": "design/v3/01-routing-and-navigation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The biggest churn in the migration is href literals; a builder plus a lint rule forbidding string-built console hrefs lets one codemod touch every Link exactly once and keeps them from regressing."}, {"id": "design_v3_01_routing_and_navigation_slug_history", "label": "slug_history redirects and per-parent uniqueness", "file_type": "concept", "source_file": "design/v3/01-routing-and-navigation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Renames regenerate the slug with an old-slug redirect row; DB unique constraints on (org_id, slug) and (competition_id, slug) plus a -2 suffix dedupe migration land before the switch."}, {"id": "design_v3_01_routing_and_navigation_legacy_301", "label": "Legacy id routes 301 for >=2 releases", "file_type": "concept", "source_file": "design/v3/01-routing-and-navigation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No redirect table is needed since ids stay resolvable; hits are logged so the team knows when the old routes are actually dead. /api/v1 stays id-based because it is a machine surface with no reason to churn."}], "edges": [{"source": "design_v3_01_routing_and_navigation_routing_and_navigation", "target": "design_v3_01_routing_and_navigation_org_comp_div_url_scheme", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v3/01-routing-and-navigation.md", "source_location": null, "weight": 1.0}, {"source": "design_v3_01_routing_and_navigation_url_beats_cookie", "target": "design_v3_01_routing_and_navigation_org_comp_div_url_scheme", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v3/01-routing-and-navigation.md", "source_location": null, "weight": 1.0}, {"source": "design_v3_01_routing_and_navigation_breadcrumbs", "target": "design_v3_01_routing_and_navigation_org_comp_div_url_scheme", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v3/01-routing-and-navigation.md", "source_location": null, "weight": 1.0}, {"source": "design_v3_01_routing_and_navigation_back_button", "target": "design_v3_01_routing_and_navigation_breadcrumbs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v3/01-routing-and-navigation.md", "source_location": null, "weight": 1.0}, {"source": "design_v3_01_routing_and_navigation_route_builder", "target": "design_v3_01_routing_and_navigation_org_comp_div_url_scheme", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v3/01-routing-and-navigation.md", "source_location": null, "weight": 1.0}, {"source": "design_v3_01_routing_and_navigation_slug_history", "target": "design_v3_01_routing_and_navigation_org_comp_div_url_scheme", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v3/01-routing-and-navigation.md", "source_location": null, "weight": 1.0}, {"source": "design_v3_01_routing_and_navigation_legacy_301", "target": "design_v3_01_routing_and_nav