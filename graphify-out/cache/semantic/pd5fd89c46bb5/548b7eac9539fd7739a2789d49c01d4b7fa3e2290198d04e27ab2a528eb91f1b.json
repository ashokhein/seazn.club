{"nodes": [{"id": "design_v5_01_translation_pipeline_en_source_of_truth", "label": "en dictionaries are the single source of truth", "file_type": "rationale", "source_file": "design/v5/01-translation-pipeline.md", "source_location": "header", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The other five locales are generated artifacts humans review; never hand-edit en and a target in the same PR without regenerating."}, {"id": "design_v5_01_translation_pipeline_translate_script", "label": "scripts/translate-dictionaries.ts (Batches API)", "file_type": "code", "source_file": "design/v5/01-translation-pipeline.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Batches gives 50% token price and latency is irrelevant offline; value hashing into .hashes.json makes it idempotent and incremental so reviewed translations do not churn."}, {"id": "design_v5_01_translation_pipeline_glossary", "label": "scripts/i18n-glossary.json (protected terms + sport vocabulary)", "file_type": "rationale", "source_file": "design/v5/01-translation-pipeline.md", "source_location": "\u00a71/\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Brand, plan names, proper-noun sport formats and 'API' are never translated; the glossary is a reviewable file rather than prompt-embedded prose."}, {"id": "design_v5_01_translation_pipeline_ci_guards", "label": "i18n CI guards (key parity, placeholder parity, drift, ratchet)", "file_type": "rationale", "source_file": "design/v5/01-translation-pipeline.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drift compares the en value hash against .hashes.json to catch stale translations; the hardcoded-string ratchet fails new JSX literals while existing files burn down via a shrinking allowlist."}, {"id": "design_v5_01_translation_pipeline_pseudo_locale", "label": "en-XA pseudo-locale for layout QA", "file_type": "rationale", "source_file": "design/v5/01-translation-pipeline.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lengthens strings ~35% and brackets them so overflow shows up at 390px before any real translation lands; dev-only, generated locally, never committed."}, {"id": "design_v5_01_translation_pipeline_help_docs", "label": "Help docs: translate top-8, fall back to en with a notice", "file_type": "rationale", "source_file": "design/v5/01-translation-pipeline.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "31 en markdown docs stay canonical; a markdown-aware prompt preserves headings/anchors/frontmatter and skips code and paths, and help search stays an en index plus per-locale title index."}, {"id": "design_v5_01_translation_pipeline_review_workflow", "label": "Review workflow (native-speaker pass for hi/ta)", "file_type": "rationale", "source_file": "design/v5/01-translation-pipeline.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "fr/es/nl are acceptable at MT quality for launch and flagged; review state lives in git history rather than // REVIEWED markers because regenerations only touch keys whose en source changed."}], "edges": [{"source": "design_v5_01_translation_pipeline_translate_script", "target": "design_v5_01_translation_pipeline_en_source_of_truth", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v5/01-translation-pipeline.md", "source_location": "\u00a72", "weight": 1.0}, {"source": "design_v5_01_translation_pipeline_translate_script", "target": "design_v5_01_translation_pipeline_glossary", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "s