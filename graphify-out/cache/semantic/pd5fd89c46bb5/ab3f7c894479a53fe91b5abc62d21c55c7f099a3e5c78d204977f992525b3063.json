{"nodes": [{"id": "design_v2_sports_table_tennis_tabletennis_module", "label": "Table Tennis module (setbased preset)", "file_type": "document", "source_file": "design/v2/sports/table-tennis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v2_sports_table_tennis_uncapped_deuce", "label": "Games to 11, win by 2, no cap", "file_type": "concept", "source_file": "design/v2/sports/table-tennis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v2_sports_table_tennis_team_ties", "label": "Table tennis team tie (parent_fixture_id showcase)", "file_type": "rationale", "source_file": "design/v2/sports/table-tennis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parent lineup nominates players and the competition layer (not the module) materialises child fixtures; the parent outcome folds from child outcomes and remaining children are cancelled. Standings count parent results while child results feed player stats."}, {"id": "design_v2_sports_table_tennis_ittf_cascade", "label": "ITTF recursive h2h cascade", "file_type": "rationale", "source_file": "design/v2/sports/table-tennis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ratios are computed on tied-group results only and recursively \u2014 the classic partition-refinement test case for the tiebreaker engine."}, {"id": "design_v2_sports_table_tennis_game_summary_reachability", "label": "game.summary reachability validation", "file_type": "concept", "source_file": "design/v2/sports/table-tennis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A coarse summary is rejected unless the predicate could actually have produced it (12-10 accepted, 11-10 rejected), which