{"nodes": [{"id": "design_v4_01_llm_contract_model_call_params", "label": "Model call parameters (messages.parse, adaptive thinking, effort high)", "file_type": "rationale", "source_file": "design/v4/01-llm-contract.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Structured output via zodOutputFormat plus adaptive thinking lets the model plan with depth controlled by effort; refusal stop_reason is checked before reading content so a refusal never leaks into the parser."}, {"id": "design_v4_01_llm_contract_context_pack", "label": "Deterministic context pack JSON", "file_type": "rationale", "source_file": "design/v4/01-llm-contract.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sorted keys and stable fixture ordering make it snapshot-testable and prompt-cache friendly; budgeted at \u226460K tokens, above which the route already 422s on fixture count."}, {"id": "design_v4_01_llm_contract_ai_schedule_plan", "label": "AiSchedulePlan zod output schema", "file_type": "code", "source_file": "design/v4/01-llm-contract.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v4_01_llm_contract_ai_assignment", "label": "AiAssignment", "file_type": "code", "source_file": "design/v4/01-llm-contract.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v4_01_llm_contract_ai_constraint_delta", "label": "AiConstraintDelta", "file_type": "code", "source_file": "design/v4/01-llm-contract.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v4_01_llm_contract_system_prompt", "label": "SYSTEM_PROMPT (verbatim schedule architect prompt)", "file_type": "rationale", "source_file": "design/v4/01-llm-contract.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ships verbatim and is golden-tested so edits break a test; states HARD RULES the server verifier enforces and a ranked SOFT GOALS list (instruction > compactness > fairness > stability) so conflicts resolve predictably."}, {"id": "design_v4_01_llm_contract_hard_rules", "label": "Hard rules H1\u2013H7", "file_type": "rationale", "source_file": "design/v4/01-llm-contract.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Court legality, occupancy interval, blackouts/session windows, entrant and shared-person overlap plus rest, startWindows, feed ordering, and pinned/obstacle immutability \u2014 the exact set the deterministic referee re-checks."}, {"id": "design_v4_01_llm_contract_message_protocol", "label": "Message protocol (turn 1 pack, repair turns, refine run)", "file_type": "rationale", "source_file": "design/v4/01-llm-contract.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Assistant turns are replayed unchanged (thinking blocks included); refine starts a fresh conversation and the server rebuilds the pack from live DB state because fixtures may have moved since the prior proposal."}, {"id": "design_v4_01_llm_contract_prompt_cache_control", "label": "Ephemeral cache_control on the system prompt", "file_type": "rationale", "source_file": "design/v4/01-llm-contract.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Intended so repair/refine rounds in one run reuse the prefix; later measured as economically immaterial (0.75% saving at best)."}, {"id": "design_v4_01_llm_contract_golden_eval_fixtures", "label": "Golden eval fixtures (pack snapshot, legality harness, instruction cases, live smoke)", "file_type": "rationale", "source_file": "design/v4/01-llm-contract.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mocked Anthropic responses let the verifier/repair loop be tested deterministically; the real-API smoke is opt-in behind AI_EVAL=1 so CI never spends."}], "edges": [{"source": "design_v4_00_ai_schedule_architect_build_schedule_pack", "target": "design_v4_01_llm_contract_context_pack", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v4/01-llm-contract.md", "source_location": "\u00a72", "weight": 1.0}, {"source": "design_v4_00_ai_schedule_architect_validate_assignments_referee", "target": "design_v4_01_llm_contract_hard_rules", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v4/01-llm-contract.md", "source_location": "\u00a74", "weight": 1.0}, {"source": "design_v4_00_ai_schedule_architect_stateless_conversation", "target": "design_v4_01_llm_contract_message_protocol", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v4/01-llm-contract.md", "source_location": "\u00a75", "weight": 1.0}, {"source": "design_v4_00_ai_schedule_architect_constraint_suggestions", "target": "design_v4_01_llm_contract_ai_constraint_delta", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v4/01-llm-contract.md", "source_location": "\u00a73", "weight": 1.0}, {"source": "design_v4_01_llm_contract_ai_schedule_plan", "target": "design_v4_01_llm_contract_ai_assignment", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v4/01-llm-contract.md", "source_location": "\u00a73", "weight": 1.0}, {"source": "design_v4_01_llm_contract_ai_schedule_plan", "target": "design_v4_01_llm_contract_ai_constraint_delta", "relation": "references", "confidence": "EXTRACTED", "