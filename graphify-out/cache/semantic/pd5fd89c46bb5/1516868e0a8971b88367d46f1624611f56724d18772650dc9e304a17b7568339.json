{"nodes": [{"id": "design_v2_prompts_prompt_20_tier1_features_tier1_features", "label": "Tier-1 Features (registration, offline, player accounts)", "file_type": "document", "source_file": "design/v2/prompts/PROMPT-20-tier1-features.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three independent features bundled only so the roadmap has one entry point; explicitly to be run as three sequential sessions and split into 20a/b/c at kickoff."}, {"id": "design_v2_prompts_prompt_20_tier1_features_registration_and_entry_fees", "label": "20a Online registration & entry fees", "file_type": "concept", "source_file": "design/v2/prompts/PROMPT-20-tier1-features.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Registration materialises into an entrant idempotently on confirm; capacity with waitlist auto-promotion on withdrawal; free registration on all plans but paid registration needs Pro plus Connect onboarding."}, {"id": "design_v2_prompts_prompt_20_tier1_features_stripe_connect_entry_fees", "label": "Stripe Connect Express + application_fee_percent", "file_type": "concept", "source_file": "design/v2/prompts/PROMPT-20-tier1-features.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Webhook handling reuses the existing billing_events idempotency; refunds are auto pre-lock, manual post-lock, always audited."}, {"id": "design_v2_prompts_prompt_20_tier1_features_offline_scoring_pwa", "label": "20b Offline-first scoring PWA", "file_type": "concept", "source_file": "design/v2/prompts/PROMPT-20-tier1-features.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Running @seazn/engine in-browser lets a local fold of queued plus server events produce an optimistic scoreboard identical to the server refold."}, {"id": "design_v2_prompts_prompt_20_tier1_features_indexeddb_event_queue", "label": "IndexedDB event queue with fetch-rebase-revalidate", "file_type": "rationale", "source_file": "design/v2/prompts/PROMPT-20-tier1-features.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client-generated uuid event ids and an expected_seq chain make background sync safe; a SEQ_CONFLICT triggers rebase, and events that fail revalidation surface as a manual-resolve list and are never silently dropped."}, {"id": "design_v2_prompts_prompt_20_tier1_features_player_accounts", "label": "20c Player accounts and claim flow", "file_type": "concept", "source_file": "design/v2/prompts/PROMPT-20-tier1-features.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One active claim per person with audited staff unlink; a claimed player's own consent flags override org defaults, with a guardian link controlling consent for minors."}, {"id": "design_v2_prompts_prompt_20_tier1_features_availability_rsvp", "label": "Availability RSVP and QR self check-in", "file_type": "concept", "source_file": "design/v2/prompts/PROMPT-20-tier1-features.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "design_v2_prompts_prompt_20_tier1_features_tier1_features", "target": "design_v2_prompts_prompt_15_app_integration_cutover_v1_cutover", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v2/prompts/PROMPT-20-tier1-features.md", "source_location": null, "weight": 1.0}, {"source": "design_v2_prompts_prompt_20_tier1_features_tier1_features", "target": "design_v2_prompts_prompt_20_tier1_features_registration_and_entry_fees", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v2/prompts/PROMPT-20-tier