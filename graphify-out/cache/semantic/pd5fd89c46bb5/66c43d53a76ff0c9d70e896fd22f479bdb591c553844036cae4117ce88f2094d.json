{"nodes": [{"id": "design_v1_02_architecture_modular_monolith_principle", "label": "Modular monolith first", "file_type": "rationale", "source_file": "design/v1/02-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One deployable Next.js app; extract a service only when a bottleneck is proven \u2014 realtime fan-out is the most likely first extraction."}, {"id": "design_v1_02_architecture_pure_core_effectful_shell", "label": "Pure core, effectful shell", "file_type": "rationale", "source_file": "design/v1/02-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Engine math stays pure and DB-free so it remains testable in isolation; side effects live in server-only modules behind transactions."}, {"id": "design_v1_02_architecture_stateless_app_tier", "label": "Stateless app tier", "file_type": "rationale", "source_file": "design/v1/02-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All state in Postgres/Redis/object storage so replicas scale horizontally with zero affinity."}, {"id": "design_v1_02_architecture_target_topology", "label": "Target topology (CDN, app replicas, Postgres, Redis, storage, jobs)", "file_type": "concept", "source_file": "design/v1/02-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v1_02_architecture_upstash_redis", "label": "Upstash Redis (cache, rate limit, idempotency)", "file_type": "rationale", "source_file": "design/v1/02-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately kept completely out of the realtime path \u2014 no pub/sub \u2014 because Supabase Realtime owns all fan-out."}, {"id": "design_v1_02_architecture_inngest_job_queue", "label": "Inngest job queue and workers", "file_type": "rationale", "source_file": "design/v1/02-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen over pg-boss for native Next.js integration, durable retries and cron without worker infrastructure."}, {"id": "design_v1_02_architecture_supabase_realtime", "label": "Supabase Realtime as the fan-out layer", "file_type": "concept", "source_file": "design/v1/02-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v1_02_architecture_supabase_storage", "label": "Supabase Storage for object storage", "file_type": "concept", "source_file": "design/v1/02-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v1_02_architecture_connection_pooler", "label": "Connection pooler in front of Postgres", "file_type": "rationale", "source_file": "design/v1/02-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mandatory before horizontal scaling because the postgres package opens direct connections and replicas would exhaust the pool."}, {"id": "design_v1_02_architecture_build_vs_buy", "label": "Build-vs-buy defaults", "file_type": "concept", "source_file": "design/v1/02-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v1_02_architecture_failure_modes", "label": "Architecture failure modes and degradation policy", "file_type": "rationale", "source_file": "design/v1/02-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Redis fails open for reads but closed for billing idempotency; realtime degrades to polling rather than erroring."}], "edges": [{"source": "design_v1_02_architecture_modular_monolith_principle", "target": "design_v1_02_architecture_target_topology", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v1/02-architecture.md", "source_location": null, "weight": 1.0}, {"source": "design_v1_02_architecture_supabase_realtime", "target": "design_v1_10_supabase_realtime_broadcast_over_postgres_changes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v1/02-architecture.md", "source_location": null, "weight": 1.0}, {"source": "design_v1_02_architecture_supabase_storage", "target": "design_v1_11_supabase_storage_signed_upload_url_flow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v1/02-architecture.md", "source_location": null, "weight": 1.0}, {"source": "design_v1_02_architecture_upstash_redis", "target": "design_v1_05_payments_billing_billing_events_ledger", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "design/v1/02-architecture.md", "source_location": null, "weight": 1.0}, {"source": "design_v1_02_architecture_build_vs_buy", "target": "design_v1_04_security_compliance_sso_saml_oidc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v1/02-architecture.md", "source_location": null, "weight": 1.0}, {"source": "design_v1_02_architecture_failure_modes", "target": "design_v1_10_supabase_realtime_polling_fallback", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v1/02-architecture.md", "source_location": null, "weight": 1.0}], "hyperedges": []}