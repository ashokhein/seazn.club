{"nodes": [{"id": "design_v1_12_quality_and_engine_correctness_testing_pyramid", "label": "Testing pyramid and tooling choices", "file_type": "concept", "source_file": "design/v1/12-quality-and-engine-correctness.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v1_12_quality_and_engine_correctness_pairing_invariants", "label": "Pairing invariants P1\u2013P6", "file_type": "rationale", "source_file": "design/v1/12-quality-and-engine-correctness.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Always-true properties across every format and player count: no double participation, at most one bye, bye fairness, no premature rematch, knockout tree integrity, and stepladder non-repetition."}, {"id": "design_v1_12_quality_and_engine_correctness_standings_invariants", "label": "Standings invariants S1\u2013S4", "file_type": "rationale", "source_file": "design/v1/12-quality-and-engine-correctness.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "computeStandings must be pure and deterministic \u2014 no reliance on insertion order or Date.now() \u2014 so identical inputs always yield identical order."}, {"id": "design_v1_12_quality_and_engine_correctness_lifecycle_invariants", "label": "Lifecycle invariants L1\u2013L5", "file_type": "concept", "source_file": "design/v1/12-quality-and-engine-correctness.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v1_12_quality_and_engine_correctness_property_based_testing", "label": "Property-based testing with fast-check", "file_type": "rationale", "source_file": "design/v1/12-quality-and-engine-correctness.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generates thousands of random valid scenarios and shrinks failures to a minimal counterexample; failing seeds are persisted as golden regressions so a bug can never recur silently."}, {"id": "design_v1_12_quality_and_engine_correctness_pure_simulation_driver", "label": "DB-free pure engine simulation driver", "file_type": "rationale", "source_file": "design/v1/12-quality-and-engine-correctness.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps property tests fast without Postgres and forces the engine to stay testable in isolation, requiring pure lifecycle decisioning to be extracted out of the DB-coupled tournament.ts."}, {"id": "design_v1_12_quality_and_engine_correctness_golden_scenario_suite", "label": "Golden-scenario suite", "file_type": "concept", "source_file": "design/v1/12-quality-and-engine-correctness.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v1_12_quality_and_engine_correctness_integration_tests", "label": "Integration tests over API, DB and tenancy", "file_type": "concept", "source_file": "design/v1/12-quality-and-engine-correctness.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v1_12_quality_and_engine_correctness_e2e_critical_journeys", "label": "Playwright E2E critical journeys", "file_type": "concept", "source_file": "design/v1/12-quality-and-engine-correctness.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v1_12_quality_and_engine_correctness_ci_merge_gates", "label": "CI merge gates blocking on quality signals", "file_type": "rationale", "source_file": "design/v1/12-quality-and-engine-correctness.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Coverage is gated on the engine specifically (\u226595%) rather than a vanity global percentage; property runs use a fixed large sample in CI and a much larger one nightly."}, {"id": "design_v1_12_quality_and_engine_correctness_stepladder_bug", "label": "Stepladder 3-player rematch bug", "file_type": "rationale", "source_file": "design/v1/12-quality-and-engine-correctness.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Found manually in a real tournament after shipping; a wrong bracket fails in public on a projector and permanently destroys organizer trust, which is why this bug class justifies the whole property-testing programme."}, {"id": "design_v1_12_quality_and_engine_correctness_production_invariant_assertions", "label": "Production invariant assertions behind a flag", "file_type": "rationale", "source_file": "design/v1/12-quality-and-engine-correctness.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "So a slipped engine bug surfaces as a Sentry alert rather than a customer complaint."}], "edges": [{"source": "design_v1_02_architecture_pure_core_effectful_shell", "target": "design_v1_12_quality_and_engine_correctness_pure_simulation_driver", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v1/12-quality-and-engine-correctness.md", "source_location": null, "weight": 1.0}, {"source": "design_v1_07_reliability_operations_ci_cd_pipeline", "target": "design_v1_12_quality_and_engine_correctness_ci_merge_gates", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v1/12-quality-and-engine-correctness.md", "source_location": null, "weight": 1.0}, {"source": "design_v1_07_reliability_operations_observability", "target": "design_v1_12_quality_and_engine_correctness_production_invariant_assertions", "relation": "conceptually_related_to", "confidence": "EXTRAC