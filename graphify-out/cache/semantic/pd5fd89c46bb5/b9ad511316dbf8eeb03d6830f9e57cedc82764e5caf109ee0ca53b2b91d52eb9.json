{"nodes": [{"id": "design_v3_02_mobile_responsive_overhaul_mobile_overhaul", "label": "v3 Mobile & Responsive Overhaul", "file_type": "document", "source_file": "design/v3/02-mobile-responsive-overhaul.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Organisers run tournaments from the sideline on a phone but the console was built desktop-first; the root causes are systemic (fixed-column tables, non-wrapping flex rows, px-sized dialogs, thumb-unreachable actions) so the fix is five reusable patterns plus a regression gate, not per-page tweaks."}, {"id": "design_v3_02_mobile_responsive_overhaul_responsive_table", "label": "Pattern 1: <ResponsiveTable> table-to-card under sm", "file_type": "concept", "source_file": "design/v3/02-mobile-responsive-overhaul.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Implemented once with opt-in per table; PROMPT-31 note records that v2 panels kept tables inside scroll containers because their rows embed roster editors whose card form is a bigger redesign."}, {"id": "design_v3_02_mobile_responsive_overhaul_sticky_bottom_action_bar", "label": "Pattern 2: sticky safe-area bottom action bar", "file_type": "concept", "source_file": "design/v3/02-mobile-responsive-overhaul.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Primary actions dock within thumb reach using env(safe-area-inset-bottom) on mobile and stay inline on desktop."}, {"id": "design_v3_02_mobile_responsive_overhaul_bottom_sheet_dialog", "label": "Pattern 3: dialog renders as bottom sheet under sm", "file_type": "concept", "source_file": "design/v3/02-mobile-responsive-overhaul.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v3_02_mobile_responsive_overhaul_no_horizontal_scroll", "label": "Pattern 4: no page-level horizontal scroll, ever", "file_type": "rationale", "source_file": "design/v3/02-mobile-responsive-overhaul.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The layout gets an overflow-x-hidden guard and genuinely wide content (schedule board, brackets, standings) scrolls inside its own container with an edge-fade affordance, so the page frame never shifts."}, {"id": "design_v3_02_mobile_responsive_overhaul_touch_targets", "label": "Pattern 5: 44px touch targets, 16px input font", "file_type": "rationale", "source_file": "design/v3/02-mobile-responsive-overhaul.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Font-size at least 16px on inputs is specifically to block iOS zoom-on-focus, which otherwise breaks the layout mid-form."}, {"id": "design_v3_02_mobile_responsive_overhaul_standings_stays_table", "label": "Standings deliberately stays a table", "file_type": "rationale", "source_file": "design/v3/02-mobile-responsive-overhaul.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Comprehension depends on comparing columns across rows, so standings keeps its table inside a scroll container with a sticky frozen first column instead of collapsing to cards."}, {"id": "design_v3_02_mobile_responsive_overhaul_viewport_regression_gate", "label": "expectNoHorizontalScroll viewport regression gate", "file_type": "rationale", "source_file": "design/v3/02-mobile-responsive-overhaul.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without a CI gate the fixes rot; a Playwright 'mobile' project at 375x667 and 390x844 asserts documentElement.scrollWidth <= clientWidth on every audited route."}, {"id": "design_v3_02_mobile_responsive_overhaul_billing_mobile_fix", "label": "Billing/payment detail mobile fix (embedded checkout full-bleed)", "file_type": "concept", "source_file": "design/v3/02-mobile-responsive-overhaul.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The reported breakage is a fixed min-width parent around the embedded Stripe checkout; the container must be full-bleed and tested at 375px."}], "edges": [{"source": "design_v3_02_mobile_responsive_overhaul_mobile_overhaul", "target": "design_v3_02_mobile_responsive_overhaul_responsive_table", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v3/02-mobile-responsive-overhaul.md", "source_location": null, "weight": 1.0}, {"source": "design_v3_02_mobile_responsive_overhaul_mobile_overhaul", "target": "design_v3_02_mobile_responsive_overhaul_sticky_bottom_action_bar", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v3/02-mobile-responsive-overhaul.md", "source_location": null, "weight": 1.0}, {"source": "design_v3_02_mobile_responsive_overhaul_mobile_overhaul", "target": "design_v3_02_mobile_responsive_overhaul_bottom_sheet_dialog", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v3/02-mobile-responsive-overhaul.md", "source_location": null, "weight": 1.0}, {"source": "design_v3_02_mobile_responsive_overhaul_bottom_sheet_dialog", "target": "design_v3_03_ui_system_refresh_confirm_dialog", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v3/02-mobile-responsive-overhaul.md", "source_location": null, "weight": 1.0}, {"source": "design_v3_02_mobile_responsive_overhaul_mobile_overhaul", "target": "design_v3_02_mobile_responsive_overhaul_no_horizontal_scroll", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v3/02-mobile-responsive-overhaul.md",