{"nodes": [{"id": "design_v1_13_admin_and_account_lifecycle_staff_access_model", "label": "Platform staff access model (is_staff / staff_role)", "file_type": "rationale", "source_file": "design/v1/13-admin-and-account-lifecycle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately not reusing org RBAC \u2014 staff authority is fully decoupled from tenancy, MFA-required, and every action writes an immutable staff_audit row."}, {"id": "design_v1_13_admin_and_account_lifecycle_impersonation", "label": "Time-boxed audited impersonation", "file_type": "rationale", "source_file": "design/v1/13-admin-and-account-lifecycle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read-only by default with a persistent banner and ~30 minute TTL; writes when allowed are audited as the staff user acting-as the target, and it is never exposed to tenant admins."}, {"id": "design_v1_13_admin_and_account_lifecycle_org_360_view", "label": "Org 360 support view", "file_type": "concept", "source_file": "design/v1/13-admin-and-account-lifecycle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v1_13_admin_and_account_lifecycle_user_360_view", "label": "User 360 support view", "file_type": "concept", "source_file": "design/v1/13-admin-and-account-lifecycle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v1_13_admin_and_account_lifecycle_last_owner_protection", "label": "Last-owner protection", "file_type": "rationale", "source_file": "design/v1/13-admin-and-account-lifecycle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejects any operation that would leave an org with zero owners; concurrent role changes racing must be guarded inside a transaction with row locks on org_members."}, {"id": "design_v1_13_admin_and_account_lifecycle_transfer_org_ownership", "label": "Transfer org ownership", "file_type": "rationale", "source_file": "design/v1/13-admin-and-account-lifecycle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets a leaving owner hand off without orphaning the tenant; the previous owner is demoted to admin rather than kept as co-owner."}, {"id": "design_v1_13_admin_and_account_lifecycle_change_email", "label": "Change email with double opt-in", "file_type": "concept", "source_file": "design/v1/13-admin-and-account-lifecycle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v1_13_admin_and_account_lifecycle_delete_account", "label": "Delete account (GDPR self-serve)", "file_type": "rationale", "source_file": "design/v1/13-admin-and-account-lifecycle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Blocked when the user is sole owner of an org with other members, so deletion can never orphan a tenant."}, {"id": "design_v1_13_admin_and_account_lifecycle_leave_org", "label": "Leave org and remove member", "file_type": "concept", "source_file": "design/v1/13-admin-and-account-lifecycle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v1_13_admin_and_account_lifecycle_session_revocation_list", "label": "Server-side session revocation list", "file_type": "rationale", "source_file": "design/v1/13-admin-and-account-lifecycle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Needed so email change, password reset, member removal, suspension and impersonation expiry invalidate sessions immediately rather than at token expiry."}, {"id": "design_v1_13_admin_and_account_lifecycle_data_ownership_semantics", "label": "Data ownership when a creator leaves", "file_type": "rationale", "source_file": "design/v1/13-admin-and-account-lifecycle.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tournaments stay owned by the org because they are already org-scoped; created_by ON DELETE SET NULL must render gracefully as 'created by (former member)'."}], "edges": [{"source": "design_v1_03_multi_tenancy_data_model_tenant_lifecycle_states", "target": "design_v1_13_admin_and_account_lifecycle_delete_account", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v1/13-admin-and-account-lifecycle.md", "source_location": null, "weight": 1.0}, {"source": "design_v1_13_admin_and_account_lifecycle_staff_access_model", "target": "design_v1_04_security_compliance_audit_hash_chain", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v1/13-admin-and-account-lifecycle.md", "source_location": null, "weight": 1.0}, {"source": "design_v1_13_admin_and_account_lifecycle_session_revocation_list", "target": "design_v1_04_security_compliance_auth_hardening", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v1/13-admin-and-account-lifecycle.md", "source_location": null, "weight": 1.0}, {"source": "design_v1_13_admin_and_account_lifecycle_impersonation", "target": "design_v1_10_supabase_realtime_mint_realtime_token", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "design/v1/13-admin-and-account-lifecycle.md", "source_location": null, "weight": 1.0}, {"source": "design_v1_13_admin_and_account_lifecycle_impersonation", "target": "design_v1_13_admin_and_account_lifecycle_staff_access_model", "relation": "references", "confidence": "EXTRA