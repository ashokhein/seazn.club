{"nodes": [{"id": "design_v2_sports_chess_chess_module", "label": "Chess module (boardgame preset)", "file_type": "document", "source_file": "design/v2/sports/chess.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scoring a single game is trivial; all complexity lives in the competition layer, which makes chess the stress test for the competition engine rather than the match engine."}, {"id": "design_v2_sports_chess_half_point_integers", "label": "Half-point scores as doubled integers", "file_type": "rationale", "source_file": "design/v2/sports/chess.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "win 2 / draw 1 / loss 0 keeps every score an integer \u2014 never 0.5 floats \u2014 so ledger sums and comparators stay exact."}, {"id": "design_v2_sports_chess_swiss_pairing_state", "label": "Swiss per-entrant pairing state", "file_type": "concept", "source_file": "design/v2/sports/chess.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Score, opponents, colorSeq, floats and byes are maintained by the competition engine from the module's ledger; pairing is score groups, top-half vs bottom-half fold, then backtracking transpositions honouring hard constraints (no rematch, colour balance) over soft ones."}, {"id": "design_v2_sports_chess_fide_tiebreak_cascade", "label": "FIDE tiebreak cascade (Buchholz, Sonneborn-Berger)", "file_type": "rationale", "source_file": "design/v2/sports/chess.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "These tiebreaks depend on opponents' FINAL scores, so they are computed at rank time from the opponents ledger and never folded incrementally; unplayed games use the FIDE virtual-opponent adjustment."}, {"id": "design_v2_sports_chess_ko_mini_match", "label": "Knockout mini-match tie resolution", "file_type": "rationale", "source_file": "design/v2/sports/chess.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Draws stay legal even in KO; a tie is modelled as parent_fixture_id children (classical, rapid, blitz, armageddon). Ship the simple manual-winner version first and keep the mini-match as the Pro follow-up."}, {"id": "design_v2_sports_chess_team_chess", "label": "Team chess (board order, parent fixture)", "file_type": "concept", "source_file": "design/v2/sports/chess.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v2_sports_chess_cross_table_golden", "label": "Cross-table golden against a published event", "file_type": "concept", "source_file": "design/v2/sports/chess.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mandatory because Buchholz/SB arithmetic is easy to get subtly wrong and only a real published cross-table proves it."}], "edges": [{"source": "design_v2_sports_chess_chess_module", "target": "design_v2_sports_chess_half_point_integers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v2/sports/chess.md", "source_location": null, "weight": 1.0}, {"source": "design_v2_sports_chess_chess_module", "target": "design_v2_sports_chess_swiss_pairing_state", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v2/sports/chess.md", "source_location": null, "weight": 1.0}, {"source": "design_v2_sports_chess_fide_tiebreak_cascade", "target": "design_v2_sports_chess_swiss_pairing_state", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v2/sports/chess.md", "source_location": null, "weight": 1.0}, {"source": "design_v2_sports_chess_cross_table_