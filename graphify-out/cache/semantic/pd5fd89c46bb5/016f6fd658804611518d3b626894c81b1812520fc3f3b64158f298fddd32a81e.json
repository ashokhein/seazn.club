{"nodes": [{"id": "design_v1_03_multi_tenancy_data_model_organization_tenant_boundary", "label": "Organization is the tenant boundary", "file_type": "rationale", "source_file": "design/v1/03-multi-tenancy-data-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Billing and entitlements attach to the org, not the user, because an account may belong to several orgs."}, {"id": "design_v1_03_multi_tenancy_data_model_postgres_rls_defense_in_depth", "label": "Postgres RLS as defense-in-depth isolation", "file_type": "rationale", "source_file": "design/v1/03-multi-tenancy-data-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "App checks give friendly errors and run first; RLS guarantees the database refuses cross-tenant rows even if app logic regresses."}, {"id": "design_v1_03_multi_tenancy_data_model_with_tenant_wrapper", "label": "withTenant transaction wrapper setting app.current_org GUCs", "file_type": "code", "source_file": "design/v1/03-multi-tenancy-data-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "current_setting returns null outside a tenant transaction, so policies deny by default and no rows leak."}, {"id": "design_v1_03_multi_tenancy_data_model_org_id_denormalization", "label": "org_id denormalization on hot child tables", "file_type": "rationale", "source_file": "design/v1/03-multi-tenancy-data-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recommended over FK-only policies so RLS predicates stay simple and index-friendly on players/rounds/matches/match_events."}, {"id": "design_v1_03_multi_tenancy_data_model_plans_subscriptions_tables", "label": "plans and subscriptions tables", "file_type": "concept", "source_file": "design/v1/03-multi-tenancy-data-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v1_03_multi_tenancy_data_model_plan_entitlements", "label": "plan_entitlements table", "file_type": "concept", "source_file": "design/v1/03-multi-tenancy-data-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v1_03_multi_tenancy_data_model_org_entitlement_overrides", "label": "org_entitlement_overrides table", "file_type": "rationale", "source_file": "design/v1/03-multi-tenancy-data-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exists for enterprise deals and grandfathering; a reason string is required so every override is auditable."}, {"id": "design_v1_03_multi_tenancy_data_model_usage_counters", "label": "usage_counters table and counter maintenance", "file_type": "rationale", "source_file": "design/v1/03-multi-tenancy-data-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Incremented in the same transaction as the action, with a nightly reconcile from source tables to correct drift and GREATEST(value-1,0) guarding underflow."}, {"id": "design_v1_03_multi_tenancy_data_model_entitlement_resolution_order", "label": "Entitlement resolution order: override then plan then deny", "file_type": "concept", "source_file": "design/v1/03-multi-tenancy-data-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v1_03_multi_tenancy_data_model_tenant_lifecycle_states", "label": "Tenant lifecycle states (active/suspended/deleting/purged)", "file_type": "concept", "source_file": "design/v1/03-multi-tenancy-data-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v