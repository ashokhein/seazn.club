{"nodes": [{"id": "design_v4_02_board_ux_referee_trace", "label": "Referee trace is the product (stepper + console)", "file_type": "rationale", "source_file": "design/v4/02-board-ux.md", "source_location": "\u00a70", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prototype finding: organisers do not trust a black box that returns a finished grid, they trust one they watched get caught and corrected \u2014 so the draft\u2192plan\u2192referee\u2192repair loop is promoted from a spinner to an always-shown first-class trace, gated behind prefers-reduced-motion."}, {"id": "design_v4_02_board_ux_colour_contract", "label": "Three-hue state palette (amber moved / teal verified / red flagged)", "file_type": "rationale", "source_file": "design/v4/02-board-ux.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Semantic not decorative \u2014 each hue carries exactly one domain meaning and is reused verbatim across board ghosts, diff list, stepper and console; separate from the marketing accent."}, {"id": "design_v4_02_board_ux_organiser_console", "label": "Organiser console (right dock / mobile bottom sheet)", "file_type": "rationale", "source_file": "design/v4/02-board-ux.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reuses the unscheduled-tray chrome so the AI surface does not introduce a new panel idiom."}, {"id": "design_v4_02_board_ux_fixture_block_contract", "label": "Fixture block carries colour + code + marker + matchup + time only", "file_type": "rationale", "source_file": "design/v4/02-board-ux.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prototype tried an in-block move caption and it does not fit: a 30-minute match is one ~40px slot, so move-provenance lives in the diff list / explanations instead."}, {"id": "design_v4_02_board_ux_mode_chips_and_presets", "label": "Mode chips + one-tap example presets", "file_type": "rationale", "source_file": "design/v4/02-board-ux.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A bare textarea under-performs because organisers hesitate on what to type; presets are copy, not new API, and a session-local instruction history strip is all the conversation the UI needs."}, {"id": "design_v4_02_board_ux_summary_names_the_cost", "label": "Summary must name the cost, not just the win", "file_type": "rationale", "source_file": "design/v4/02-board-ux.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When an instruction forces a trade, the model owning the compromise is the difference between 'the AI ignored me' and 'the AI understood the tension'; usage chips read as trust to the Pro audience, not noise."}, {"id": "design_v4_02_board_ux_board_states", "label": "Board states: idle / running / flagged / proposal / applied", "file_type": "rationale", "source_file": "design/v4/02-board-ux.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Errors render inline in the panel for the active step, never toast-only, so a failure is attached to the step that produced it."}, {"id": "design_v4_02_board_ux_prototype_artifact", "label": "Mocked-LLM board prototype artifact", "file_type": "document", "source_file": "design/v4/02-board-ux.md", "source_location": "header note", "source_url": "https://claude.ai/code/artifact/0cb1aa2d-8779-4c3c-8832-ec26155bc483", "captured_at": "2026-07-14", "author": null, "contributor": null}], "edges": [{"source": "design_v4_02_board_ux_referee_trace", "target": "design_v4_00_ai_schedule_architect_validate_assignments_referee", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v4/02-board-ux.md", "source_location": "\u00a70", "weight": 1.0}, {"source": "design_v4_02_board_ux_referee_trace", "target": "design_v4_02_board_ux_colour_contract", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v4/02-board-ux.md", "source_location": "\u00a71", "weight": 1.0}, {"source": "design_v4_02_board_ux_prototype_artifact", "target": "design_v4_02_board_ux_fixture_block_contract", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v4/02-board-ux.md", "source_location": "\u00a73", "weight": 1.0}, {"source": "design_v4_02_board_ux_prototype_artifact", "target": "design_v4_02_board_ux_mode_chips_and_presets", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v4/02-board-ux.md", "source_location": "\u00a74", "weight": 1.0}, {"source": "design_v4_02_board_ux_mode_chips_and_presets", "target": "design_v4_00_ai_schedule_architect_stateless_conversation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v4/02-board-ux.md", "source_location": "\u00a74", "weight": 1.0}, {"source": "design_v4_02_board_ux_summary_names_the_cost", "target": "design_v4_01_llm_contract_system_prompt", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v4/02-board-ux.md", "source_location": "\u00a75", "weight": 1.0}, {"source": "design_v4_02_board_ux_board_states", "target": "design_v4_00_ai_schedule_architect_failure_taxonomy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v4/02-board-ux.md", "source_location": "\u00a77", "weight": 1.0}, {"source": "design_v4_02_board_ux_organiser_console", "target": "design_v4_02_board_ux_board_states", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "design/v4/02-board-ux.md", "source_location": "\u00a72", "weight": 1.0}, {"source": "design_v4_prompts_prompt_43_ai_schedule_board_ux_prompt_43", "target": "design_v4_02_board_ux_referee_trace", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v4/02-board-ux.md", "source_location": "header", "weight": 1.0}], "hyperedges": []}