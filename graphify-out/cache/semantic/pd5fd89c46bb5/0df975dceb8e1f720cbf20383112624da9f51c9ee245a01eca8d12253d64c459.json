{"nodes": [{"id": "design_v1_06_marketing_site_marketing_route_group", "label": "Marketing route group separate from app routes", "file_type": "rationale", "source_file": "design/v1/06-marketing-site.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same project initially for a shared design system and simplest setup, statically rendered with no auth dependency so it can be split out later."}, {"id": "design_v1_06_marketing_site_home_page_sections", "label": "Home page section plan", "file_type": "rationale", "source_file": "design/v1/06-marketing-site.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The interactive format showcase renders a real sample bracket from the engine because breadth of formats is the differentiator being sold."}, {"id": "design_v1_06_marketing_site_pricing_page", "label": "Pricing page with humanized entitlement matrix", "file_type": "concept", "source_file": "design/v1/06-marketing-site.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v1_06_marketing_site_public_tournament_pages", "label": "Public tournament pages at /t/[slug]", "file_type": "rationale", "source_file": "design/v1/06-marketing-site.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cacheable, entitlement-aware branding, OG images and schema.org SportsEvent markup so every shared event becomes inbound traffic with a 'Create your own' CTA."}, {"id": "design_v1_06_marketing_site_seo_content_strategy", "label": "SEO and long-tail content strategy", "file_type": "rationale", "source_file": "design/v1/06-marketing-site.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Performance is treated as SEO \u2014 static plus CDN wi