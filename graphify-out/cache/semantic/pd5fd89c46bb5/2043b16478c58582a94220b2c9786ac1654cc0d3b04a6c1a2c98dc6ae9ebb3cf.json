{"nodes": [{"id": "design_v1_10_supabase_realtime_broadcast_over_postgres_changes", "label": "Broadcast chosen over postgres_changes", "file_type": "rationale", "source_file": "design/v1/10-supabase-realtime.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "postgres_changes ships row payloads and needs RLS aligned to Supabase JWT roles, which clashes with custom cookie auth; broadcast lets the server control the payload and keeps /state authoritative."}, {"id": "design_v1_10_supabase_realtime_channel_design", "label": "Channel and event design (tournament:{id} / state_changed)", "file_type": "rationale", "source_file": "design/v1/10-supabase-realtime.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Payload is deliberately minimal (v, reason, at) so no stale partial state can be rendered from the event itself."}, {"id": "design_v1_10_supabase_realtime_supabase_admin", "label": "supabaseAdmin() server-only service-role client", "file_type": "code", "source_file": "design/v1/10-supabase-realtime.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v1_10_supabase_realtime_publish_tournament_update", "label": "publishTournamentUpdate()", "file_type": "code", "source_file": "design/v1/10-supabase-realtime.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Called after transaction commit and wrapped in try/catch \u2014 a failed broadcast must never roll back a recorded result."}, {"id": "design_v1_10_supabase_realtime_mint_realtime_token", "label": "mintRealtimeToken()", "file_type": "code", "source_file": "design/v1/10-supabase-realtime.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v1_10_supabase_realtime_use_tournament_realtime", "label": "useTournamentRealtime() client hook", "file_type": "code", "source_file": "design/v1/10-supabase-realtime.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v1_10_supabase_realtime_state_version_debounce", "label": "state_version counter and client debounce", "file_type": "rationale", "source_file": "design/v1/10-supabase-realtime.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One mutation can touch many rows; a per-tournament version plus a 200-300ms client debounce prevents N refetches. Publishing once per mutation from app code is preferred first because it needs no column."}, {"id": "design_v1_10_supabase_realtime_subscriber_authentication", "label": "Subscriber authentication with short-lived minted JWTs", "file_type": "rationale", "source_file": "design/v1/10-supabase-realtime.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "We do not use Supabase Auth, so our API mints a 1h JWT signed with SUPABASE_JWT_SECRET; for v1 the token endpoint plus an unguessable UUID channel is deemed sufficient, with Realtime Authorization policies tightened in Phase 3."}, {"id": "design_v1_10_supabase_realtime_polling_fallback", "label": "Community polling fallback", "file_type": "rationale", "source_file": "design/v1/10-supabase-realtime.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 403 from the token endpoint degrades silently to the existing 5s poll, so realtime is an enhancement and never a hard dependency."}], "edges": [{"source": "design_v1_10_supabase_realtime_publish_tournament_update", "target": "design_v1_10_supabase_realtime_supabase_admin", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v1/10-supabase-realtime.md", "source_location": null, "weight": 1.0}, {"source": "design_v1_10_supabase_realtime_publish_tournament_update", "target": "design_v1_10_supabase_realtime_channel_design", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v1/10-supabase-realtime.md", "source_location": null, "weight": 1.0}, {"source": "design_v1_10_supabase_realtime_mint_realtime_token", "target": "design_v1_10_supabase_realtime_subscriber_authentication", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v1/10-supabase-realtime.md", "source_location": null, "weight": 1.0}, {"source": "design_v1_10_supabase_realtime_use_tournament_realtime", "target": "design_v1_10_supabase_realtime_mint_realtime_token", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v1/10-supabase-realtime.md", "source_location": null, "weight": 1.0}, {"source": "design_v1_10_supabase_realtime_use_tournament_realtime", "target": "design_v1_10_supabase_realtime_state_version_debounce", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v1/10-supabase-realtime.md", "source_location": null, "weight": 1.0}, {"source": "design_v1_10_supabase_realtime_channel_design", "target": "design_v1_10_supabase_realtime_broadcast_over_postgres_changes", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v1/10-supabase-realtime.md", "source_location": null, "weight": 1.0}, {"source": "design_v1_10_supabase_realtime_subscriber_authentication", "target": "design_v1_05_payments_billing_entitlement_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v1/10-supabase-realtime.md", "source_location": null, "weight": 1.0}, {"source": "design_v1_10_supabase_realtime_polling_fallback", "target": "design_v1_01_product_strategy_tier_matrix", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v1/10-supabase-realtime.md", "source_location": null, "weight": 1.0}], "hyperedges": []}