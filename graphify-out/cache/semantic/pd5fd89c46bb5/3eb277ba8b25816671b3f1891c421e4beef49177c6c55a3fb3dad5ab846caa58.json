{"nodes": [{"id": "design_v2_sports_cricket_cricket_module", "label": "Cricket module", "file_type": "document", "source_file": "design/v2/sports/cricket.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Asymmetric innings, two resources, unit-dependent result phrasing, mid-match target rewriting and a draw that is not a tie \u2014 cricket is why the engine is event-sourced and why config is data."}, {"id": "design_v2_sports_cricket_innings_totals", "label": "InningsTotals as the single downstream shape", "file_type": "rationale", "source_file": "design/v2/sports/cricket.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ball-by-ball (Pro) and innings-summary (Community) are two producers of the same shape; all result math, NRR and DLS read only InningsTotals so result logic never peeks at ball events."}, {"id": "design_v2_sports_cricket_ball_ledger", "label": "Fine-fidelity ball ledger and per-ball enforcement", "file_type": "concept", "source_file": "design/v2/sports/cricket.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Legal-delivery accounting, free-hit dismissal restrictions, striker rotation, bowler constraints and all-out detection are enforced per ball rather than reconstructed later."}, {"id": "design_v2_sports_cricket_cricket_toss_event", "label": "cricket.toss as a dedicated pre-phase event", "file_type": "rationale", "source_file": "design/v2/sports/cricket.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The kernel's core.start schema is strictObject({}) per spec 03 \u00a72 and carries no sport data, so the toss is recorded as its own event in the pre phase."}, {"id": "design_v2_sports_cricket_nrr_ledger", "label": "NRR ledger stored as integers", "file_type": "rationale", "source_file": "design/v2/sports/cricket.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only integers are stored (runs/balls for and against) and comparison is by cross-multiplication at rank time; an all-out side is charged the full quota, and DLS-revised matches use revised quotas."}, {"id": "design_v2_sports_cricket_dls", "label": "DLS as a pure function over the resource table", "file_type": "rationale", "source_file": "design/v2/sports/cricket.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Our computation only pre-fills an explicit revise event \u2014 the umpire's numbers always win over ours; the par-score curve is exposed for the live ahead/behind widget."}, {"id": "design_v2_sports_cricket_super_over", "label": "Super over as a recursive mini-match", "file_type": "concept", "source_file": "design/v2/sports/cricket.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v2_sports_cricket_format_variants", "label": "Age/format divisions as data variants", "file_type": "rationale", "source_file": "design/v2/sports/cricket.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "U13/U16/ODI differ only in ballsPerInnings and maxOversPerBowler \u2014 one module, data variants; junior cutoff dates vary by board so the cutoff is explicit in the eligibility rule and never assumed."}, {"id": "design_v2_sports_cricket_tie_vs_no_result", "label": "tie vs no_result distinction", "file_type": "concept", "source_file": "design/v2/sports/cricket.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both award one point but they occupy different columns in the table, so the outcome kinds must stay distinct."}], "edges": [{