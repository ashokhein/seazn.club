{"nodes": [{"id": "design_v2_sports_football_football_module", "label": "Football module", "file_type": "document", "source_file": "design/v2/sports/football.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v2_sports_football_match_state_machine", "label": "Football match state machine (ET/shootout sub-machines)", "file_type": "rationale", "source_file": "design/v2/sports/football.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Draws are first-class in leagues but forbidden in knockouts; if neither extra time nor a shootout is configured the engine refuses to finalize with WRONG_PHASE rather than silently recording a KO draw."}, {"id": "design_v2_sports_football_shootout_algorithm", "label": "Shootout algorithm and points split", "file_type": "rationale", "source_file": "design/v2/sports/football.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Best-of-5 alternating, decided early when the lead exceeds the opponent's remaining kicks, then sudden death; the regulation score stays a draw in metrics while competition points may split shootout win/loss (youth-cup 2/1)."}, {"id": "design_v2_sports_football_fifa2026_preset", "label": "fifa2026 vs classic tiebreaker presets", "file_type": "rationale", "source_file": "design/v2/sports/football.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two competing official traditions exist (H2H-first vs GD-first) and organisers argue about them, so both ship as presets with UEFA-style recursive H2H available via a flag."}, {"id": "design_v2_sports_football_fair_play_metric", "label": "Fair-play metric from cards", "file_type": "concept", "source_file": "design/v2/sports/football.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v2_sports_football_coarse_vs_timeline", "label": "Coarse goals vs Pro match timeline", "file_type": "rationale", "source_file": "design/v2/sports/football.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Minutes and scorers are optional on every event, so the same fold serves a bare goal{by} stream and the full Pro timeline."}, {"id": "design_v2_sports_football_abandonment_policy", "label": "Abandonment and forfeit policy", "file_type": "concept", "source_file": "design/v2/sports/football.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "replay is the default (fixture flagged for regeneration and finalize refused while undecided); the 'stand' policy is deliberately reserved for a later prompt rather than half-shipped."}, {"id": "design_v2_sports_football_two_legged_ties", "label": "Two-legged ties and away_goals key", "file_type": "concept", "source_file": "design/v2/sports/football.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Aggregate is computed by the competition layer from the fixture pair; away goals stays as an off-by-default cascade key for legacy leagues even though UEFA abolished it in 2021."}], "edges": [{"source": "design_v2_sports_football_football_module", "target": "design_v2_sports_football_match_state_machine", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v2/sports/football.md", "source_location": null, "weight": 1.0}, {"source": "design_v2_sports_football_match_state_machine", "target": "design_v2_sports_football_shootout_algorithm", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v2/sports/football.md", "source_location": null, "weight": 1.0}, {"source": "design_v2