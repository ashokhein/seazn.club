{"nodes": [{"id": "docs_superpowers_plans_2026_07_13_player_accounts_player_accounts_plan", "label": "Player Accounts (PROMPT-53) Implementation Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-07-13-player-accounts.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deviations recorded on purpose: presence lives on fixture_availability.checked_in_at (a person may check in before any lineup exists), and claim/checkin accept endpoints sit outside /api/v1 so key-scope enumeration stays clean."}, {"id": "docs_superpowers_plans_2026_07_13_player_accounts_person_claims_usecases", "label": "person-claims usecases (mint/resolve/claim/unlink)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-13-player-accounts.md", "source_location": "Task 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tokens are random secrets hashed at rest (device-links pattern), rows are never deleted because claimed_at/revoked_at/invited_by ARE the audit trail, and each failure mode gets a distinct error code."}, {"id": "docs_superpowers_plans_2026_07_13_player_accounts_me_usecases", "label": "me.ts usecases (fixtures, availability, consent)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-13-player-accounts.md", "source_location": "Task 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cross-org superuser reads because the player is not an org member; consent writes fire fireDivisionRevalidate for every division the person is rostered in so the public card flips immediately. persons.dob is never in a player-facing payload \u2014 only the derived lock flag."}, {"id": "docs_superpowers_plans_2026_07_13_player_accounts_consent_locked", "label": "consentLocked(dob) helper", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-13-player-accounts.md", "so