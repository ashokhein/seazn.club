{"nodes": [{"id": "docs_superpowers_plans_2026_07_12_perf_approach_a_perf_plan", "label": "Approach A \u2014 Monolith Tuning Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-07-12-perf-approach-a.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Everything stays in the apps/web monolith; the revalidate+purge work concentrates at one seam so a later Cloud Run move only swaps transports there."}, {"id": "docs_superpowers_plans_2026_07_12_perf_approach_a_connection_options", "label": "connectionOptions pure derivation", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-12-perf-approach-a.md", "source_location": "Task 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Option derivation was buried in getClient and untestable; extracting it makes pool size env-tunable (DB_POOL_MAX 1..50) and pins the :6543-disables-prepare rule in a unit test."}, {"id": "docs_superpowers_plans_2026_07_12_perf_approach_a_slug_redis_cache", "label": "Redis Read-Through Slug Cache", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-12-perf-approach-a.md", "source_location": "Task 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Caches positive LIVE resolutions only: renames and misses always hit Postgres because the slug_history fallback is correctness-critical and rare. TTL bounds a missed invalidation."}, {"id": "docs_superpowers_plans_2026_07_12_perf_approach_a_peer_revalidate", "label": "Peer ISR Revalidation Broadcast", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-12-perf-approach-a.md", "source_location": "Task 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "revalidateTag only invalidates the machine that handled the write, so with 2 machines the instant-refresh-after-a-score contract breaks; peers fan out over Fly 6PN and never re-broadcast, which prevents loops."}, {"id": "docs_superpowers_plans_2026_07_12_perf_approach_a_next_image_public", "label": "next/image on Public Storage Assets", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-12-perf-approach-a.md", "source_location": "Task 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only Supabase Storage public objects are optimizable \u2014 arbitrary OAuth avatar hosts stay on plain <img> because remotePatterns cannot enumerate the internet."}, {"id": "docs_superpowers_plans_2026_07_12_perf_approach_a_csp_cacheable_public", "label": "Cacheable Public Routes Keep Report-Only CSP", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-07-12-perf-approach-a.md", "source_location": "Task 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nonce CSP forces dynamic rendering, so flipping CSP_MODE=enforce would silently kill ISR and any CDN for /shared, /embed and /r; those trees stay nonce-free and report-only permanently."}, {"id": "docs_superpowers_plans_2026_07_12_perf_approach_a_deferred_helper", "label": "deferred() tail-work helper", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-12-perf-approach-a.md", "source_location": "Task 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wraps Next after() with an inline fallback outside a request scope so vitest and scripts keep working; standings recompute stays awaited because it must commit before the response."}, {"id": "docs_superpowers_plans_2026_07_12_perf_approach_a_cdn_purge", "label": "CDN Purge Seam (debounced purge_everything)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-12-perf-approach-a.md", "source_location": "Task 7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At this site's size a full purge per 30s window is cheaper and simpler than tag->URL mapping, and s-maxage bounds staleness when a purge is missed."}], "edges": [{"source": "docs_superpowers_plans_2026_07_12_perf_approach_a_slug_redis_cache", "target": "docs_superpowers_plans_2026_07_10_prompt_30_routing_slug_history", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-07-12-perf-approach-a.md", "source_location": "Task 2 \u2014 history fallback always hits Postgres", "weight": 1.0}, {"source": "docs_superpowers_plans_2026_07_12_perf_approach_a_slug_redis_cache", "target": "docs_superpowers_plans_2026_07_10_prompt_30_routing_slug_resolvers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-07-12-perf-approach-a.md", "source_location": "Task 2 \u2014 modifies server/slug-resolve.ts", "weight": 1.0}, {"source": "docs_superpowers_plans_2026_07_12_perf_approach_a_peer_revalidate", "target": "docs_superpowers_plans_2026_07_12_perf_approach_a_cdn_purge", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-07-12-perf-approach-a.md", "source_location": "Task 7 Step 4 \u2014 both wired at the same fire*Revalidate seam", "weight": 1.0}, {"source": "docs_superpowers_plans_2026_07_12_perf_approach_a_csp_cacheable_public", "target": "docs_superpowers_plans_2026_07_12_perf_approach_a_cdn_purge", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/plans/2026-07-12-perf-approach-a.md", "source_location": "Task 5 / Task 7 \u2014 a nonce CSP would un-cache the tree the CDN purges", "weight": 1.0}, {"source": "docs_superpowers_plans_2026_07_12_perf_approach_a_deferred_helper", "target": "docs_superpowers_plans_2026_07_12_perf_approach_a_peer_revalidate", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/superpowers/plans/2026-07-12-perf-approach-a.md", "source_location": "Task 6 \u2014 same fire-and-forget/fail-open contract as fire*Revalidate", "weight": 1.0}, {"source": "docs_superpowers_plans_2026_07_12_perf_approach_a_slug_redis_cache", "target": "docs_superpowers_plans_2026_07_11_prompt_36_pricing_packaging_comp_scoped_entitlements", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/superpowers/plans/2026-07-12-perf-approach-a.md", "source_location": "same cache-aside + pattern-invalidation shape over @/lib/cache", "weight": 1.0}], "hyperedges": [{"id": "perf_approach_a_slices", "label": "Approach A monolith-tuning slices", "nodes": ["docs_superpowers_plans_2026_07_12_perf_approach_a_connection_options", "docs_superpowers_plans_2026_07_12_perf_approach_a_slug_redis_cache", "docs_superpowers_plans_2026_07_12_perf_approach_a_peer_revalidate", "docs_superpowers_plans_2026_07_12_perf_approach_a_next_image_public", "docs_superpowers_plans_2026_07_12_perf_approach_a_csp_cacheable_public", "docs_superpowers_plans_2026_07_12_perf_approach_a_deferred_helper", "docs_superpowers_plans_2026_07_12_perf_approach_a_cdn_purge"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-07-12-perf-approach-a.md"}]}