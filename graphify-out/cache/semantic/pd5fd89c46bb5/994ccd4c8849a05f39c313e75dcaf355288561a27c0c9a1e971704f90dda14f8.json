{"nodes": [{"id": "design_v6_01_rules_digest_rules_digest", "label": "Official rules digest (normative source for constants)", "file_type": "rationale", "source_file": "design/v6/01-rules-digest.md", "source_location": "header", "source_url": null, "captured_at": "2026-07-12", "author": null, "contributor": null, "rationale": "Every scoring constant in a v6 module traces to a row here, so a rulebook revision has one place to land instead of being scattered across module code."}, {"id": "design_v6_01_rules_digest_itf_rules_of_tennis", "label": "ITF Rules of Tennis 2026", "file_type": "paper", "source_file": "design/v6/01-rules-digest.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v6_01_rules_digest_iihf_rulebook", "label": "IIHF Official Rule Book 2025/26 + 2026 Event Code", "file_type": "paper", "source_file": "design/v6/01-rules-digest.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v6_01_rules_digest_fih_rules", "label": "FIH Rules of Hockey 2026 + Tournament Regs App 12", "file_type": "paper", "source_file": "design/v6/01-rules-digest.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v6_01_rules_digest_iihf_points_321", "label": "IIHF 3-2-1-0 points allocation (\u00a7219)", "file_type": "rationale", "source_file": "design/v6/01-rules-digest.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wire format is 1 point each at a 60-minute tie plus 1 extra to the OT/GWS winner, which is why the period kernel needs otWin/otLoss on top of W/D/L."}, {"id": "design_v6_01_rules_digest_fih_team_plays_short", "label": "FIH cards make the team play short", "file_type": "rationale", "source_file": "design/v6/01-rules-digest.md", "source_location": "\u00a73", "source_