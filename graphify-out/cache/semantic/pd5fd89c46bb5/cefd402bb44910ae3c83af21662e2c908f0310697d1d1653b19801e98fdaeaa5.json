{"nodes": [{"id": "docs_superpowers_specs_2026_07_22_email_invite_auto_login_design_invite_claim_route", "label": "POST /api/invites/[token]/claim", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-22-email-invite-auto-login-design.md", "source_location": "Architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mirrors the magic-link consume route: page \u2192 POST, route mints the session. POST only and IP rate-limited so email scanners and link prefetch cannot consume it, and to avoid CSRF. Session mint, verified-flip and join run together so the single use is burned coherently."}, {"id": "docs_superpowers_specs_2026_07_22_email_invite_auto_login_design_verified_account_gate", "label": "The safety gate: users.email_verified", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-22-email-invite-auto-login-design.md", "source_location": "The safety gate", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An invite can be forwarded, so minting a session for a VERIFIED account would be account takeover of that person's real orgs, billing and data. An unverified or absent account has nothing to steal, so auto-login there is safe. The gate is one boolean, and once verified a replayed token hits needs_signin even before the use-count check."}, {"id": "docs_superpowers_specs_2026_07_22_email_invite_auto_login_design_invite_token_trust_model", "label": "Invite token = magic-link-grade credential", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-22-email-invite-auto-login-design.md", "source_location": "Trust model", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An email-bound, single-use, 24-random-byte invite token emailed to the invited address proves control of that inbox \u2014 the same basis consumeLoginLink \u2192 createSession already relies on. So the second magic-link email is redundant and the accept path may mint a session."}, {"id": "docs_superpowers_specs_2026_07_22_email_invite_auto_login_design_resolve_or_create_user", "label": "resolveOrCreateUser (extracted to lib/users.ts)", "file_type": "code", "source_file": "docs/superpowers/specs/2026-07-22-email-invite-auto-login-design.md", "source_location": "Shared helpers", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_22_email_invite_auto_login_design_claim_invite_component", "label": "ClaimInvite client component", "file_type": "code", "source_file": "docs/superpowers/specs/2026-07-22-email-invite-auto-login-design.md", "source_location": "New client component", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sits under the terms notice so the claim also stamps terms acceptance; on needs_signin it falls back to the existing AuthForm rather than dead-ending."}], "edges": [{"source": "docs_superpowers_specs_2026_07_22_email_invite_auto_login_design_invite_claim_route", "target": "docs_superpowers_specs_2026_07_22_email_invite_auto_login_design_verified_account_gate", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-22-email-invite-auto-login-design.md", "source_location": "Architecture", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_22_email_invite_auto_login_design_invite_token_trust_model", "target": "docs_superpowers_specs_2026_07_22_email_invite_auto_login_design_invite_claim_route", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-22-email-invite-auto-login-design.md", "source_location": "Trust model", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_22_email_invite_auto_login_design_invite_claim_route", "target": "docs_superpowers_specs_2026_07_22_email_invite_auto_login_design_resolve_or_create_user", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-22-email-invite-auto-login-design.md", "source_location": "Architecture step 4", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_22_email_invite_auto_login_design_claim_invite_component", "target": "docs_superpowers_specs_2026_07_22_email_invite_auto_login_design_invite_claim_route", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-22-email-invite-auto-login-design.md", "source_location": "New client component", "weight": 1.0}], "hyperedges": []}