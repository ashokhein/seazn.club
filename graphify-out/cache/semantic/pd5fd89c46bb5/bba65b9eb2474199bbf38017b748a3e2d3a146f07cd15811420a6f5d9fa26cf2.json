{"nodes": [{"id": "docs_superpowers_specs_2026_07_22_transfer_offer_recipient_surface_incoming_transfer_offers", "label": "IncomingTransferOffers component", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-22-transfer-offer-recipient-surface.md", "source_location": "Fix A", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The accept UI lived inside BillingGroupPanel, which only renders when isPayer \u2014 so a recipient who is not already a payer somewhere misses the offer entirely, despite the panel's comment claiming an incoming offer is never missed. The new component renders unconditionally, and the block is removed from the panel so payers do not see it twice."}, {"id": "docs_superpowers_specs_2026_07_22_transfer_offer_recipient_surface_send_transfer_offer_email", "label": "sendTransferOfferEmail", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-22-transfer-offer-recipient-surface.md", "source_location": "Fix B", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Called best-effort from offerGroupTransfer after the offer row commits, on both the live-sub and community paths \u2014 it must never throw, because the offer must succeed even if email fails."}, {"id": "docs_superpowers_specs_2026_07_22_transfer_offer_recipient_surface_offer_cost_summary", "label": "Offer-scoped billing summary endpoint", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-22-transfer-offer-recipient-surface.md", "source_location": "Fix C", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Today the recipient enters a card with no idea what they are committing to. The summary is gated to the offer's recipient (who is explicitly NOT the payer, so payer-gated overviews do not apply) and must state plainly that accepting charges nothing now \u2014 handOverGroup only sets the incoming card as default, the current period is already paid."}], "edges": [{"source": "docs_superpowers_specs_2026_07_22_transfer_offer_recipient_surface_incoming_transfer_offers", "target": "docs_superpowers_specs_2026_07_21_billing_groups_design_transfer_group", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-22-transfer-offer-recipient-surface.md", "source_location": "Confirmed root cause", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_22_transfer_offer_recipient_surface_incoming_transfer_offers", "target": "docs_superpowers_specs_2026_07_21_billing_groups_design_l2_owner_payer_split", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/specs/2026-07-22-transfer-offer-recipient-surface.md", "source_location": "Fix A", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_22_transfer_offer_recipient_surface_send_transfer_offer_email", "target": "docs_superpowers_specs_2026_07_22_transfer_offer_recipient_surface_incoming_transfer_offers", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-22-transfer-offer-recipient-surface.md", "source_location": "Fix B", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_22_transfer_offer_recipient_surface_offer_cost_summary", "target": "docs_superpowers_specs_2026_07_22_transfer_offer_recipient_surface_incoming_transfer_offers", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-22-transfer-offer-recipient-surface.md", "source_location": "Fix C", "weight": 1.0}], "hyperedges": []}