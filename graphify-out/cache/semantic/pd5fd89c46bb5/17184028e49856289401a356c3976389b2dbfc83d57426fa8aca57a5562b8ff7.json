{"nodes": [{"id": "design_v2_prompts_prompt_17_scheduling_console_scheduling_console", "label": "Scheduling Console (auto + drag-and-drop)", "file_type": "document", "source_file": "design/v2/prompts/PROMPT-17-scheduling-console.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v2_prompts_prompt_17_scheduling_console_schedule_settings_schema", "label": "schedule_settings table + fixtures.schedule_source/locked", "file_type": "concept", "source_file": "design/v2/prompts/PROMPT-17-scheduling-console.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_v2_prompts_prompt_17_scheduling_console_propose_then_apply", "label": "Propose-then-apply scheduling API", "file_type": "rationale", "source_file": "design/v2/prompts/PROMPT-17-scheduling-console.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "schedule/auto only proposes (calling the engine calendar pass with locked fixtures as obstacles); schedule/apply is the transactional persist plus division_events audit, so an auto pass can never silently overwrite an organiser's board."}, {"id": "design_v2_prompts_prompt_17_scheduling_console_calendar_locked_assignments", "label": "Calendar pass lockedAssignments extension", "file_type": "rationale", "source_file": "design/v2/prompts/PROMPT-17-scheduling-console.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Locked assignments enter as fixed obstacles and the pass stays pure and deterministic, giving the property: re-run with all outputs locked produces zero moves."}, {"id": "design_v2_prompts_prompt_17_scheduling_console_conflict_taxonomy", "label": "Conflict taxonomy (block vs warn)", "file_type": "rationale", "source_file": "design/v2/prompts/PROMPT-17-scheduling-console.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only court clashes and direct-feed ordering block; rest violations and the rest warn, because a real organiser sometimes has to accept a tight turnaround."}, {"id": "design_v2_prompts_prompt_17_scheduling_console_division_launch_actions", "label": "Two launch actions and the division state machine", "file_type": "concept", "source_file": "design/v2/prompts/PROMPT-17-scheduling-console.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Quick-start (generate, sequence-slot, active) serves the organiser who does not care about times; Schedule (generate, auto pass, board) serves the one who does. Scoring endpoints reject events before start."}, {"id": "design_v2_prompts_prompt_17_scheduling_console_drag_and_drop_board", "label": "Drag-and-drop schedule board", "file_type": "concept", "source_file": "design/v2/prompts/PROMPT-17-scheduling-console.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optimistic move with debounced validate keeps dragging responsive; a keyboard select-then-move alternative is required for a11y."}, {"id": "design_v2_prompts_prompt_17_scheduling_console_publish_gate", "label": "Published-schedule-only public surface", "file_type": "rationale", "source_file": "design/v2/prompts/PROMPT-17-scheduling-console.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unpublished edits stay invisible to the public schedule tab and .ics so organisers can rework a day without spamming players; revalidateTag fires on apply and publish."}], "edges": [{"source": "design_v2_prompts_prompt_17_scheduling_console_scheduling_console", "target": "design_v2_prompts_prompt_17_scheduling_console_schedule_settings_schema", "relation": "references", "confidence"