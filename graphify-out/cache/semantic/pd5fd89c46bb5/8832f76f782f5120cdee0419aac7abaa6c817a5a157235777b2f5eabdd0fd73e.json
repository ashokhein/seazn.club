 ["design_v4_00_ai_schedule_architect_build_schedule_pack", "design_v4_00_ai_schedule_architect_slot_fixtures_draft", "design_v4_prompts_prompt_41_ai_schedule_engine_run_ai_plan", "design_v4_00_ai_schedule_architect_validate_assignments_referee", "design_v4_00_ai_schedule_architect_repair_round_loop", "design_v4_01_llm_contract_ai_schedule_plan"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/v4/00-ai-schedule-architect.md"}]}